#!/usr/bin/env bash
# Write a review packet (the change and nothing about the author's reasoning)
# and print its directory.
#
# usage: nomad-review-packet [base-ref]
# The base defaults to the merge base with origin/HEAD, then main, then master.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
base=${1:-}
if [ -z "$base" ]; then
  for candidate in origin/HEAD origin/main main origin/master master; do
    if git rev-parse -q --verify "$candidate" >/dev/null; then
      base=$(git merge-base HEAD "$candidate"); break
    fi
  done
fi
[ -n "$base" ] || { echo "nomad-review-packet: no base found; pass one" >&2; exit 1; }

packet=$(mktemp -d "${TMPDIR:-/tmp}/nomad-review.XXXXXX")
{
  echo "repository: $root"
  echo "base: $(git rev-parse --short "$base") ($(git log -1 --format=%s "$base"))"
  echo "head: $(git rev-parse --short HEAD)"
  echo
  echo "commits since base (subjects only):"
  git log --format='- %h %s' "$base"..HEAD
} >"$packet/README.txt"
git diff --stat "$base" >"$packet/stat.txt"
git diff "$base" >"$packet/change.diff"
git ls-files --others --exclude-standard >"$packet/untracked.txt"
echo "$packet"
